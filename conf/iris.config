//
// IRIS (SLURM) options that do not depend on the assay (WES or WGS).
// The per-assay resources are in tempo-wes-iris.config and
// tempo-wgs-iris.config.
//

executor {
    name = "slurm"
    queueSize = 2000
}

params {
  mem_per_core = false
  maxWallTime = 167.h
}

process {

  //clusterOptions = "--partition test01"
  beforeScript = "unset R_LIBS; catch_term () { echo 'caught USR2/TERM signal'; set +e; false; on_exit ; } ; trap catch_term USR2 TERM"
  scratch = false // true was using /tmp even when TMPDIR set correctly

  maxRetries    = 2
  errorStrategy = { task.attempt <= process.maxRetries ? 'retry' : 'ignore' }

  //
  // DO NOT PUT cluster job resource settings here
  // Those go into the assay specific configs (tempo-wes,
  // tempo-wgs)
  //

}
