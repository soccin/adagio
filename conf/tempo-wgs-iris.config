//
// These should just be the options that do
// _not_ depend on the cluster but the which
// pipeline we are running: wes vs wgs
//
// WGS specific options
//
// This one is hard coded with IRIS specific limits
//

params {
    max_records_in_ram = "5000000"
}

//
// Tiered queue/time picker.
//
// `ladder` is a list of [queue: <str>, time: <Duration>] maps, ordered
// from shortest tier to longest. Behavior per task.attempt:
//   attempt 1                  -> ladder[0]
//   retry, prev hit walltime   -> step one tier up (clamped to last)
//   retry, prev was non-wall   -> stay in current tier
//
// "Walltime hit" = previous run took >= (prev tier's time - 5min).
// task.previousTrace.realtime is ms (Nextflow 25.x); null/missing is
// treated as MAX to force escalation defensively.
//
def safetyMs = 5 * 60 * 1000

def tierFor = { task, ladder ->
    if ( task.attempt == 1 ) return 0
    def prevIdx   = Math.min( task.attempt - 2, ladder.size() - 1 )
    def prevCapMs = ladder[prevIdx].time.toMillis()
    def realMs    = (task.previousTrace?.realtime ?: Long.MAX_VALUE)
    def hitWall   = realMs >= (prevCapMs - safetyMs)
    def idx       = hitWall ? prevIdx + 1 : prevIdx
    return Math.min( idx, ladder.size() - 1 )
}

def queueFor = { task, ladder -> ladder[ tierFor(task, ladder) ].queue }
def timeFor  = { task, ladder -> ladder[ tierFor(task, ladder) ].time  }

def shortMediumLongLadder = [
    [queue: 'cpushort,cmobic_short', time: 2.h  ],
    [queue: 'cmobic_short',          time: 3.h  ],
    [queue: 'cmobic_cpu',            time: 167.h],
]

//
// SV-caller ladders. Neither caller can ever reach a short queue: of the
// COMPLETED tasks on record ZERO SomaticDellyCall and ZERO SomaticRunSvABA
// tasks finished inside 3h -- fastest 4.30h and 3.23h respectively. Every
// rung therefore pins cmobic_cpu.
//
// TWO RUNGS, TWO ATTEMPTS. Both callers are bimodal in BOTH axes, and the
// two modes are the same two libraries, so time and memory must move
// together or a retry is wasted:
//
//   normal library  -- Delly peak RSS p50 11.0GB, p99 18.0GB, max 22.6GB
//                      over 775 IRIS tasks, and sub-day runtime. Finishes
//                      on rung 1.
//   damaged FFPE    -- e.g. APTL_00036_T01. Delly OOM-killed (exit 137) on
//                      all 5 SV types at 32GB inside 37 min, then needed
//                      256GB, with INS peaking 428KB under a 256GB cap.
//                      Runs for days. Only rung 2 can finish it.
//
// Rung 1 sizes the normal library: 11h is the 75th percentile of the sub-24h
// completions (10.46h in traces_Delly_SvABA.txt), 32GB is 1.4x the 22.6GB
// peak-RSS max. Those readings are trustworthy, not cap-truncated -- the
// high ones come from tasks that had requested 160GB and used 11% of it.
//
// Rung 2 is the everything rung: 7 days and 320GB. It covers every damaged-
// library peak on record (66, 79.6, 107, 108, 110, two at 135GB) with 2.4x
// margin, and clears the 256GB that Delly-INS came within 428KB of
// exceeding. See TEMPO_SV_RESOURCES.md.
//
// Rung 1 is deliberately small enough to OOM a damaged library fast. That is
// the design, not a cost: the whole partition is 19 nodes x 56 cores /
// ~1007GB, so at 2 cpus a 32GB Delly packs 28 tasks/node (cores bind) where
// a flat 320GB packs 3. The price is one wasted ~35 min job per damaged
// library; the return is ~9x the concurrency for every other library.
//
// NOTE the rung is chosen by task.attempt alone -- NOT by tierFor, which
// only promotes after a wall-time kill. With a single retry that test is
// wrong: an OOM at 35 min is not a wall-time kill, so tierFor would hand
// attempt 2 the same 32GB that just killed it. There is no attempt 3 to
// recover, so attempt 2 takes the top rung unconditionally.
//
// errorStrategy is overridden on both processes below to allow exactly one
// retry (attempts 1..2) instead of the maxRetries = 2 set in
// conf/iris.config.
//

def rungFor = { task, ladder -> ladder[ Math.min( task.attempt - 1, ladder.size() - 1 ) ] }

def dellyLadder = [
    [queue: 'cmobic_cpu', time:  11.h, memory:  32.GB],
    [queue: 'cmobic_cpu', time: 167.h, memory: 320.GB],
]

// SvABA memory ramps on the same two rungs, 48GB -> 320GB (was a flat
// 480GB). Unlike Delly, SvABA's footprint tracks its thread count -- it runs
// at 94-98% of every core it is given (mean 752% of 800% at 8 cpus, 3617% of
// 3700% at 37) and peak RSS follows: 9.5-10.5GB at 8 cpus, 21.0-23.4GB at
// 37, extrapolating to ~25GB at the 42 cpus configured here. 48GB is 1.9x
// that. Rung 2's 320GB covers the damaged FFPE pair's 181.0 GiB peak with
// 1.8x margin and sits above the 256GB it has already run under without an
// OOM; TEMPO_SV_RESOURCES.md suggests 400GB for a manual rerun, so raise it
// if a rung-2 SvABA is ever seen at exit 137.
//
// No SvABA task has ever been OOM-killed on record -- every failure is a
// wall-time kill -- so rung 1 is not expected to trip on memory. If a
// damaged library does press against 48GB it will be wall-time-killed at 6h
// and promoted to rung 2 anyway, which is the same outcome.
//
// Sizing note, eyes open: this buys no extra concurrency while cpus = 42.
// cmobic_cpu is 19 nodes of 56 cores, so two SvABA tasks cannot share a node
// at any memory figure -- cores bind at 1 task/node, and 19 concurrent
// tasks, either way. The gain is scheduling latency (a node needs 48GB free
// to accept the job, not 480GB) and honest accounting, not throughput. If
// SvABA throughput ever becomes the bottleneck, the lever is cpus, not
// memory.
def svabaLadder = [
    [queue: 'cmobic_cpu', time:   6.h, memory:  48.GB],
    [queue: 'cmobic_cpu', time: 167.h, memory: 320.GB],
]

process {

  //
  // Attempt 1: submit to short queues (2h cap fits both cpushort=2h and
  // cmobic_short=3h). On retry: if the previous attempt ran < 1h55m
  // (6_900_000 ms), it almost certainly did NOT hit the 2h wall-time
  // limit (failure was OOM / transient / etc.), so stay in the short
  // queues with another 2h request. Otherwise escalate to the long
  // queue cmobic_cpu with the original time ramp (shifted one attempt
  // to the left).
  //
  // task.previousTrace.realtime is a long in milliseconds (Nextflow 25.x);
  // null on attempt 1, defensively treated as MAX on a missing-trace retry.
  //
  queue = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 'cpushort,cmobic_short' : 'cmobic_cpu' }
  time  = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 48.h * (task.attempt - 1) : 167.h) }

  withName:CrossValidateSamples {
    cpus = { 2 }
    memory = { 1.GB }
    executor = 'local'
  }
  withName:SplitLanesR1 {
    cpus = { 2 }
    memory = { 1.GB }
  }
  withName:SplitLanesR2 {
    cpus = { 2 }
    memory = { 1.GB }
  }
  //
  // AlignReads: use the short/medium/long ladder so a walltime hit steps
  // tier-by-tier (2h -> 3h -> 167h) rather than jumping straight to the
  // long queue. See queueFor / timeFor and shortMediumLongLadder at the
  // top of this file. CPU formula stays WGS-specific (16 + 8 * attempt);
  // WGS alignment is heavier than WES, so the WES 4 + 4 reduction is not
  // ported here.
  //
  withName:AlignReads {
    cpus   = { 16 + 8 * task.attempt }
    memory = { 15.GB }
    queue  = { queueFor(task, shortMediumLongLadder) }
    time   = { timeFor (task, shortMediumLongLadder) }
  }
  withName:GATK4SPARK_MARKDUPLICATES {
    cpus = { 16 }
    memory = { (4.GB + (task.attempt).GB) * task.cpus }
  }
  withName:GATK4SPARK_SETNMMDANDUQTAGS {
    cpus = { 4 }
    memory = { (2.GB + (task.attempt).GB) * task.cpus }
  }
  withName:BQSR_SPLITINTERVALS {
    cpus = { 2 }
    memory = { (1.GB + (task.attempt).GB) * task.cpus }
  }
  withName:GATK4SPARK_BASERECALIBRATOR {
    cpus = { 4 }
    memory = { (8.GB + (task.attempt).GB) * task.cpus }
  }
  withName:GATK4_GATHERBQSRREPORTS {
    cpus = { 4 }
    memory = { (2.GB + (task.attempt).GB) * task.cpus }
  }
  withName:GATK4SPARK_APPLYBQSR {
    cpus = { 8 }
    memory = { (8.GB + (task.attempt).GB) * task.cpus }
  }
  withName:'MERGE_SETTAGS_BAM|MERGE_BQSR_BAM' {
    cpus = { 8 }
    memory = { (2.GB + (task.attempt).GB) * task.cpus }
  }
  withName:'INDEX_SETTAGS_BAM|INDEX_BQSR_BAM' {
    cpus = { 8 }
    memory = { (2.GB + (task.attempt).GB) * task.cpus }
  }
  withName:CreateScatteredIntervals {
    cpus = { 2 }
    memory = { (1.GB * task.attempt) * task.cpus }
  }

  // RunMutect2 is hard coded to take 8Gb in `-Xmx8g`
  // 1 cpu for mutect and and 1 for singularity
  //
  // Also add some resources on subsequent attempts
  // to help if the program is congestion
  //
  withName:RunMutect2 {
    cpus = { 2 + 1 * task.attempt }
    memory = { 10.GB + 5.GB * task.attempt }
  }
  
  withName:SomaticCombineMutect2Vcf {
    cpus = { 1 + 1 * task.attempt }
    memory = { 2.GB + 2.GB * task.attempt }
  }

  withLabel:multiqc_process { // SampleRunMultiQC , SomaticRunMultiQC , CohortRunMultiQC
    cpus = { 4 + 12 * task.attempt }
    memory = { 34.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: SomaticRunSVclone {
    cpus = { 4 + 12 * task.attempt }
    memory = { 34.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName:SomaticAnnotateMaf {
    cpus = { 4 + 12 * task.attempt }
    memory = { 34.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName:SomaticFacetsAnnotation {
    cpus = { 4 + 12 * task.attempt }
    memory = { 34.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName:RunPolysolver {
    cpus = { 8 }
    memory = { 16.GB * task.attempt }
  }

  withName:QcQualimap {
    cpus = { task.attempt<=2 ? 4 : 8 }
    memory = { 20.GB } // N.B. Tempo multiples mem by cpu's for this process

    // Calculate what TEMPO actually uses
    clusterOptions = {
      def requestedMem = task.cpus * task.memory.toGiga() * 1.1  // Add 10% buffer
      "--mem=${requestedMem.intValue()}G"
    }

  }


  //
  // SvABA: set from measurement, not estimate. Basis: 162 COMPLETED
  // SomaticRunSvABA tasks over 125 tumor/normal pairs
  // (completedTempoSVJobs.csv); 122 of them on the previous IRIS setting
  // of 37 cpus / 96GB, covering 108 pairs in 4 cohorts.
  //
  // No 2h attempt. The block used to carry no `queue`, so it inherited the
  // process-level short-queue default above and attempt 1 always went to
  // cpushort with 2h. The fastest SvABA task ever recorded is 3.23h, so
  // that attempt was a guaranteed wall-time kill on every pair of every
  // run, leaving only 2 real attempts out of 3. It goes straight to
  // cmobic_cpu.
  //
  // cpus 37 -> 28/42/50. SvABA is genuinely parallel: %cpu median 3620% at
  // 37 cpus = 97.8% of the allocation sustained over a 5.3h median run.
  // But 37 packs badly. cmobic_cpu is heterogeneous -- 14 nodes of
  // 56 cores/1007GB (isca227-240) plus 5 of 96 cores/1511GB
  // (isco001-004,006), 1264 cores total. At 37 cpus that is 1 task on a
  // 56-core node and 2 on a 96-core node: 24 concurrent tasks with 376 of
  // 1264 cores (30%) stranded. At 28 it is 2 and 3: 43 concurrent with
  // 60 cores (4.7%) stranded. Per-task runtime rises ~37/28 (5.32h median
  // -> ~7h projected); throughput rises ~1.36x. 14/19/24/32 were checked
  // and are all worse or tied.
  //
  // The 42/50 on retry give up that packing win on purpose: 42 is 1 task
  // per 56-core node, 50 is 1 task per node of either size. Retries are
  // rare, so a handful of half-idle nodes is cheap next to letting a slow
  // task fail a second time on the clock. The ramp is what pays for the
  // shortened time ladder -- see the top of this file.
  //
  // memory 96 -> 48/256/512GB. Peak RSS at 37 cpus (= 74 svaba threads, see
  // below) was median 24.6GB, p95 26.2GB, max 29.3GB over 122 tasks -- the
  // 96GB request was 3.3x the observed maximum. 48GB is 1.6x it, and at
  // 28 cpus cores bind before memory does on every cmobic_cpu node, so the
  // remaining headroom is free. Retries escalate hard because the only
  // failures seen are damaged FFPE libraries: Manta needed 159.8GB on
  // APTL_00036_T01 and is the only hard upper bound anyone has for that
  // sample, so attempt 2's 256GB already clears it and 512GB on attempt 3
  // is the last-shot margin. Both fit alongside their cpu counts on every
  // node (42 cpus + 256GB, 50 cpus + 512GB); the memory ramp also tracks
  // the rising thread count, since svaba now gets -p ${task.cpus}.
  //
  // time 167h -> 12/24/24h ladder. 122 of 122 tasks finished under 7h, so
  // 12h on attempt 1 is ~1.7x the projected 28-cpu median. 167h could not
  // rescue any observed job; it only let a wedged task hold its cores for a
  // week -- APTL_00036_T01 attempt 2 ran 60h before OOMing at 16GB and
  // produced nothing. The two 24h rungs are not a plateau in real terms
  // because the cpus rise underneath them; see the top of this file.
  //
  // NOTE: SomaticRunSvABA.nf and GermlineRunSvABA.nf used to pass
  // -p ${task.cpus * 2}. The cgroup caps the task at task.cpus anyway
  // (%cpu 3620 against a 3700 allocation), so the doubled thread count
  // bought no throughput and only cost memory. Both modules now pass
  // -p ${task.cpus} (2026-08-16).
  //
  // The 48GB attempt-1 request is left unchanged: it was sized against RSS
  // measured at the doubled thread count (median 24.6GB, max 29.3GB at 74
  // threads), so those figures are now an upper bound and the request is
  // more conservative than before. Re-measure at the halved thread count
  // before lowering it.
  //
  // The '.*RunSvABA' pattern also matches GermlineRunSvABA, which is not in
  // the default WGS workflow set and has no measurements here.
  //

  //
  // Two attempts, two rungs: 48GB/6h then 320GB/7d. See svabaLadder above.
  //
  withName: '.*RunSvABA' {
    cpus          = { 42 }
    memory        = { rungFor(task, svabaLadder).memory }
    queue         = { rungFor(task, svabaLadder).queue  }
    time          = { rungFor(task, svabaLadder).time   }
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
  }

  withName:RunLOHHLA {
    cpus = { 4 + 12 * task.attempt }
    memory = { 34.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 6.h * (task.attempt - 1) : 24.h) }
  }

  //
  // Delly is the one documented exception to short-queue-first, and its
  // resources are set from measurement rather than estimate. Basis: 811
  // COMPLETED SomaticDellyCall tasks over 125 tumor/normal pairs and 8
  // projects (completedTempoSVJobs.csv). This supersedes the earlier
  // 565-task delly_nf_traces.txt figures, which did not include the
  // damaged-FFPE tail. 775 of the 811 tasks ran on IRIS; the rest are
  // JUNO/LSF rows and supply the tail numbers below.
  //
  // Runtime: min 4.30h. ZERO of 811 tasks finished inside 2h, and ZERO
  // inside 3h, so Delly cannot clear either short tier and stepping it
  // through the 2h -> 3h ladder only burns its retry budget on the way to
  // the queue it always had to reach. It goes straight to cmobic_cpu. The
  // explicit queue matters: without it this block inherits the
  // process-level short-queue default above.
  //
  // Time and memory: see dellyLadder at the top of this file. Both now move
  // together on a single two-rung, two-attempt ramp (32GB/11h -> 320GB/7d),
  // which replaces the old flat-24h time probe and the 32/256/512GB memory
  // ramp. The probe is finished: the answer it was after is that the damaged
  // libraries need 256GB+ (INS came within 428KB of exceeding 256GB), and
  // that Delly-BND on those libraries is wall-time-bound rather than
  // memory-bound -- it survived 512GB for a full 24h without an OOM. Flat
  // 24h could never have finished it; the 7-day rung 2 can.
  //
  // Attempt 1 memory must stay at 32GB: peak RSS on IRIS was median 11.0GB,
  // p95 16.1GB, p99 18.0GB, max 22.6GB. Do NOT raise it "for headroom" --
  // at 2 cpus, 64GB makes memory rather than cores the binding constraint
  // and partition-wide concurrency falls 632 -> 325, very nearly doubling
  // the wall-clock of the Delly stage; see the packing note below. The old
  // failure was never attempt 1, it was the second rung: 64GB missed the
  // damaged-library peaks of 66, 79.6, 107, 108 and 110GB, so a retry
  // walked straight into a second OOM. Escalate steeply and clear it in the
  // one retry available.
  //
  // What rung 1 clips, knowingly: on IRIS Delly ran median 6.85h, p90 14.3h,
  // p95 17.3h, p99 21.8h, max 27.70h, so a sub-day task above 11h is
  // wall-time-killed and re-run on rung 2. That is ~25% of tasks paying an
  // 11h false start, bought against ~9x the concurrency for all of them.
  // Revisit the 11h if the observed retry rate runs well above that.
  //
  // cpus 3 -> 2. Delly runs at 99.9% of a single core whether given 2, 3
  // or 4 cpus, across all 811 tasks -- it is single-threaded plus IO, and
  // extra cpus buy nothing but pack worse. On cmobic_cpu (14 nodes of
  // 56 cores/1007GB + 5 of 96 cores/1511GB) 3 cpus gives 412 concurrent
  // slots against 632 at 2 cpus, and a 120-pair cohort costs 19,252
  // core-hours at 3 cpus against 12,835 at 2 -- 6,417 core-hours saved,
  // about 5 hours of the whole partition. 100 IRIS tasks have already run
  // at 2 cpus and all completed. Note that at 3 cpus it was *cores* that
  // bound packing, not memory (32GB allows 31 tasks/node, 3 cpus allows
  // 18); the memory ceiling only starts to bind above ~36GB at 2 cpus.
  //

  //
  // Two attempts, two rungs: 32GB/11h then 320GB/7d. See dellyLadder above.
  //
  withName: SomaticDellyCall {
    cpus          = { 2 }
    memory        = { rungFor(task, dellyLadder).memory }
    queue         = { rungFor(task, dellyLadder).queue  }
    time          = { rungFor(task, dellyLadder).time   }
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
  }

  withName: GermlineDellyCall {
    cpus = { 2 + 1 * task.attempt }
    memory = { 160.GB * task.attempt } // 160, 320, 480, 640
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 55.h * (task.attempt - 1) : 167.h) }
  }

  //
  // Same with Neoantigen
  //
  withName: RunNeoantigen {
    cpus = { 4 * task.attempt }
    memory = { 160.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : 167.h }
  }

  //
  // Default SLURM config
  //


  withName: 'runBRASS.+' {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: runBRASS {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: SomaticRunManta {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: GermlineRunManta {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: SomaticRunStrelka2 {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: GermlineRunStrelka2 {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: SomaticCombineChannel {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: GermlineCombineChannel {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: RunMsiSensor {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: RunMutationSignatures {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: MetaDataParser {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: HRDetect {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: CohortRunMultiQC {
    cpus = { 4 + 12 * task.attempt } // 16,28,40,52
    memory = { 246.GB * task.attempt }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

  withName: DoFacets {
    cpus = { task.attempt <= 2 ? 2 : 4 }
    memory = { task.attempt <= 2 ? 64.GB : 128.GB }
    time = { ( task.attempt == 1 || (task.previousTrace?.realtime ?: Long.MAX_VALUE) < 6_900_000 ) ? 2.h : (task.attempt < 4 ? 30.h * (task.attempt - 1) : 167.h) }
  }

}
